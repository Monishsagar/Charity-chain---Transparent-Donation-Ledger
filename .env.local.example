# Supabase Configuration
# Get these from your Supabase project settings

# From: Settings > API > URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# From: Settings > API > Anon Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# From: Settings > Database > Connection Pooling > Service Role Key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Email Notifications (Resend)
# Sign up at https://resend.com to get API key
RESEND_API_KEY=re_1234567890abcdef...

# Optional: Payment Gateway (Stripe)
# Sign up at https://stripe.com to get API key
STRIPE_PUBLIC_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...

# Application Configuration
NODE_ENV=development
